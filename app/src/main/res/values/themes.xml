<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.ApniVehicle" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_cta</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.ApniVehicle.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.ApniVehicle.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.ApniVehicle.LargeComponent</item>
        <!-- Material You elevation overlays -->
        <item name="elevationOverlayEnabled">true</item>
        <!-- Ripple color -->
        <item name="colorControlHighlight">@color/ripple_primary</item>
    </style>

    <style name="Theme.ApniVehicle" parent="Base.Theme.ApniVehicle" />

    <style name="Theme.ApniVehicle.NoActionBar" parent="Theme.ApniVehicle">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.ApniVehicle.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.ApniVehicle.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.ApniVehicle.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.ApniVehicle.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ApniVehicle.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="Widget.ApniVehicle.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="android:paddingTop">4dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.ApniVehicle.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <!-- Notification Panel PopupWindow background -->
    <style name="NotificationPanelAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_down_fade_in</item>
        <item name="android:windowExitAnimation">@anim/slide_up_fade_out</item>
    </style>

</resources>
